#
# TEST ONLY image for testing/linux-tests (SystemdFailoverIT), never published: the prebuilt base
# (Dockerfile.systemd-base: systemd as PID 1) plus radiusward from the release image and the units, env file and
# sysctl file of deploy/systemd installed unchanged, as docs/operations/bare-metal.md describes. The test copies the
# properties files and /etc/radiusward/radiusward.env in and enables a unit with systemctl, as an operator would.
# Needs a privileged container with tmpfs on /run and /run/lock. Needs no network: nothing is installed here.
#
#   docker build -f testing/linux-tests/docker/Dockerfile.systemd \
#       --build-arg BASE_IMAGE=$(scripts/test-images.sh ref systemd-base) -t radiusward-systemd:dev .
ARG BASE_IMAGE
ARG RELEASE=radiusward:dev
FROM ${RELEASE} AS release

FROM ${BASE_IMAGE}
COPY --from=release /opt/radiusward/ /opt/radiusward/
COPY --from=release /usr/local/bin/radiusward /usr/local/bin/radiusward
COPY deploy/systemd/radiusward-node.service deploy/systemd/radiusward-gateway.service /etc/systemd/system/
COPY deploy/systemd/99-radiusward.conf /etc/sysctl.d/99-radiusward.conf
ENV RADIUSWARD_PROFILE=small
WORKDIR /
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
CMD []
