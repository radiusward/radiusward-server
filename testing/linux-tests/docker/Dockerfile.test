#
# TEST ONLY image for testing/linux-tests, never published: the prebuilt base (Dockerfile.test-base: LazyFS, fuse3,
# iptables) plus radiusward from the release image. With RADIUSWARD_TEST_LAZYFS=1 the data directory lives on
# LazyFS; killing the container kills LazyFS, so everything not fsynced is lost, as in a power cut. Runs as root
# (FUSE mount, iptables). Needs no network: nothing is installed here.
#
#   docker build -f testing/linux-tests/docker/Dockerfile.test \
#       --build-arg BASE_IMAGE=$(scripts/test-images.sh ref linux-test-base) -t radiusward-test:dev .
ARG BASE_IMAGE
ARG RELEASE=radiusward:dev
FROM ${RELEASE} AS release

FROM ${BASE_IMAGE}
COPY --from=release /opt/radiusward/ /opt/radiusward/
COPY --from=release /usr/local/bin/radiusward /usr/local/bin/radiusward
COPY testing/linux-tests/docker/lazyfs.toml /etc/lazyfs.toml
COPY testing/linux-tests/docker/test-entrypoint.sh /usr/local/bin/test-entrypoint
WORKDIR /var/lib/radiusward
ENV RADIUSWARD_PROFILE=small
VOLUME ["/var/lib/radiusward"]
ENTRYPOINT ["/usr/local/bin/test-entrypoint"]
CMD ["version"]
