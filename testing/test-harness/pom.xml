<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>radiusward-test-harness</artifactId>
    <name>radiusward :: test harness</name>
    <description>In-JVM local cluster for integration tests and dev mode</description>

    <properties>
        <!-- not published (ADR 0068) -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- test classes start their own clusters, ports and directories: two JVMs at a time -->
        <radiusward.it.forks>2</radiusward.it.forks>
    </properties>

    <dependencies>
        <dependency>
            <!-- PacketBuilder: signed requests under AccountingRequest -->
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-images</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-cluster-node</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-radclient</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-admin-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-store-file</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-server</artifactId>
            <type>test-jar</type>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Reports, Await, Ports -->
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
