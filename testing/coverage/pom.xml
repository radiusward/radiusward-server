<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>coverage</artifactId>
    <packaging>pom</packaging>
    <name>radiusward :: coverage</name>
    <description>One coverage report over all modules, unit and integration tests (-Pcoverage)</description>

    <dependencies>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radius-dictionary</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radius-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radius-codec</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>cluster-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>export-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>exporter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>sink-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>sink-postgres</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>sink-radius</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>cluster-node</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radclient</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>admin-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>distribution</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>test-harness</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <dataFileIncludes>
                                <dataFileInclude>target/jacoco.exec</dataFileInclude>
                                <dataFileInclude>target/jacoco-it.exec</dataFileInclude>
                            </dataFileIncludes>
                            <excludes>
                                <!-- generated: SBE codecs and the hot-attribute accessors (the generators have tests) -->
                                <exclude>io/radiusward/protocol/**</exclude>
                                <exclude>io/radiusward/radius/codec/attributes/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- after report-aggregate (same phase, declared later): fails the build below a module floor -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-floors</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/check-floors.sh</argument>
                                <argument>${project.build.directory}/site/jacoco-aggregate/jacoco.csv</argument>
                                <argument>${project.basedir}/floors.properties</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
