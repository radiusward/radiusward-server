<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>radiusward-coverage</artifactId>
    <packaging>pom</packaging>
    <name>radiusward :: coverage</name>
    <description>One coverage report over all modules, unit and integration tests (-Pcoverage)</description>

    <properties>
        <!-- not published (ADR 0068) -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-dictionary</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-codec</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-cluster-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-export-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-exporter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-sink-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-sink-postgres</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-sink-radius</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-units</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-store-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-store-sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-store-ldap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-verifier-netlogon</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-cluster-node</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-radclient</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-admin-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-distribution</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-harness</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-embedded</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- test infrastructure, without floors; listed so that every analysed module finds its files in the report -->
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-support</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-eap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-images</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <dataFileIncludes>
                                <dataFileInclude>target/jacoco.exec</dataFileInclude>
                                <dataFileInclude>target/jacoco-it.exec</dataFileInclude>
                            </dataFileIncludes>
                            <excludes>
                                <!-- generated: SBE codecs and the hot-attribute accessors (the generators have tests) -->
                                <exclude>io/radiusward/protocol/**</exclude>
                                <exclude>io/radiusward/radius/codec/attributes/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- after report-aggregate (same phase, declared later): fails the build below a module floor -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-floors</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/check-floors.sh</argument>
                                <argument>${project.build.directory}/site/jacoco-aggregate/jacoco.csv</argument>
                                <argument>${project.basedir}/floors.properties</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
