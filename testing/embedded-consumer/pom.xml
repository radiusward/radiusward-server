<?xml version="1.0" encoding="UTF-8"?>
<!--
  A developer's project as it uses radiusward-embedded: no parent, no reactor, only the published artifact from a
  Maven repository. Not a module of the build: CI's e2e job builds it after `./mvnw install`
  (`./mvnw -f testing/embedded-consumer/pom.xml verify`), so a dependency the published POMs forget fails here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>nas-tests</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <radiusward.version>0.1.0-SNAPSHOT</radiusward.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-embedded</artifactId>
            <version>${radiusward.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-junit</artifactId>
            <version>${radiusward.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- Agrona and Aeron need it; the embedded server says so at start when it is missing -->
                    <argLine>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
