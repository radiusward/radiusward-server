      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(radiusward_nas_identity_mismatches_total{namespace=~\"$namespace\",member=~\"$member\"}[5m]))",
          "legendFormat": "mismatches",
          "datasource": {
