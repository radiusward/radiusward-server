      "targets": [
        {
          "refId": "A",
          "expr": "sum by (home, result) (rate(radiusward_gateway_proxy_requests_total{namespace=~\"$namespace\",gateway=~\"$gateway\"}[5m])) > 0",
          "legendFormat": "{{home}} {{result}}",
