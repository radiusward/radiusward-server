#
# /etc/radiusward/radiusward.env, read by both units; readable by root and radiusward only (it holds secrets).
# Every configuration key can be set here as RADIUSWARD_<KEY> (docs/configuration.md).
RADIUSWARD_PROFILE=small
# member hosts: this host's index into cluster.members
RADIUSWARD_CLUSTER_NODE_ID=0
# gateway hosts: a unique id per gateway, and the address the members send replies to
#RADIUSWARD_GATEWAY_ID=1
#RADIUSWARD_GATEWAY_EGRESS_HOST=10.0.0.21
# secrets referenced as ${env:...} in the properties files
NAS_SECRET=change-me
#PG_PASSWORD=change-me
