<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>radiusward-server</artifactId>
    <name>radiusward :: server</name>
    <description>The RADIUS server in front of the cluster: UDP, TCP, RadSec and DTLS</description>

    <properties>
        <!-- test classes start their own clusters, ports and directories: two JVMs at a time -->
        <radiusward.it.forks>2</radiusward.it.forks>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-packets</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-test-images</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-auth-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-store-file</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radiusward-dictionaries</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-cluster</artifactId>
        </dependency>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- the EAP test peers and test PKI, for the Netlogon module's tunnel tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
