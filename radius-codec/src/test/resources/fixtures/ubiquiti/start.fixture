# Ubiquiti UniFi AP, WPA2-Enterprise client start.
# SYNTHETIC: built from the vendor's RADIUS documentation and common deployments, not a capture.
# NAS-Identifier carries the AP MAC. IETF attributes only: the UBNT dictionary (41112) has reply attributes (rate limits).
# Acct-Multi-Session-Id stays the same when the client roams to another AP.
identifier: 70
attributes:
  Acct-Status-Type: Start
  Acct-Session-Id: 8C2F1A6B3D4E5F70
  User-Name: dave@corp.example
  NAS-IP-Address: 192.168.1.20
  NAS-Identifier: F09FC2112233
  NAS-Port-Type: Wireless-802.11
  Called-Station-Id: F0-9F-C2-11-22-33:Corp
  Calling-Station-Id: AA-BB-CC-DD-EE-06
  Acct-Multi-Session-Id: 8C2F1A6B3D4E0001
  Framed-IP-Address: 192.168.1.140
  Event-Timestamp: 1780000000
packet: 
expect:
  statusType: 1
  nasIdentifier: F09FC2112233
  multiSessionId: 8C2F1A6B3D4E0001
