    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <!-- runtime -->
        <agrona.version>2.7.0</agrona.version><!-- keep aligned with the Agrona version Aeron uses -->
        <aeron.version>1.54.0</aeron.version>
        <log4j.version>2.26.1</log4j.version>
        <disruptor.version>4.0.0</disruptor.version><!-- 4.x uses VarHandles: no sun.misc.Unsafe warnings on Java 25 -->
        <sbe.version>1.42.0</sbe.version><!-- build time only -->

        <!-- test -->
        <junit.version>5.14.4</junit.version><!-- aligned with jqwik's JUnit Platform -->
        <!-- Allure Java adapter for the published test reports (ADR 0064): the 2.x line is built for JUnit 5 (3.x needs
             JUnit 6); Allure Report 3 reads its results. Test scope only, never shipped. -->
        <allure.version>2.35.6</allure.version>
        <radiusward.reports>false</radiusward.reports>
        <assertj.version>3.27.7</assertj.version>
        <pgjdbc.version>42.7.14</pgjdbc.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- test-only reference for password hash checks; never a runtime dependency -->
        <bouncycastle.version>1.84</bouncycastle.version>
        <!-- CI sets true: tests that need Docker fail instead of being skipped -->
        <radiusward.require.docker>false</radiusward.require.docker>
        <jqwik.version>1.10.2</jqwik.version>
        <aaa4j.version>0.4.0</aaa4j.version>
        <jmh.version>1.37</jmh.version>

        <!-- plugins -->
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire.version>3.6.1</surefire.version>
        <jar-plugin.version>3.5.1</jar-plugin.version>
        <resources-plugin.version>3.5.0</resources-plugin.version>
        <install-plugin.version>3.2.0</install-plugin.version>
        <clean-plugin.version>3.5.0</clean-plugin.version>
        <deploy-plugin.version>3.2.0</deploy-plugin.version>
        <site-plugin.version>3.22.0</site-plugin.version>
        <enforcer.version>3.7.0</enforcer.version>
        <jacoco.version>0.8.16</jacoco.version>
        <exec-plugin.version>3.6.4</exec-plugin.version>
        <build-helper.version>3.7.0</build-helper.version>
        <shade-plugin.version>3.6.2</shade-plugin.version>
        <spotless.version>3.11.0</spotless.version>
        <palantir-java-format.version>2.103.0</palantir-java-format.version>

        <!-- Agrona 2.x / Aeron need access to jdk.internal.misc.Unsafe; every JVM we start must pass this -->
        <!-- stateful TLS sessions, as the gateway sets them (ADR 0034): resumption limited by the session timeout -->
        <radiusward.jvm.args>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED -Djdk.tls.server.enableSessionTicketExtension=false</radiusward.jvm.args>

        <!-- set by jacoco:prepare-agent; empty default keeps surefire working when JaCoCo is skipped -->
        <jacocoArgLine/>

        <!-- per-module overrides -->
        <jacoco.minimum.coverage>0.00</jacoco.minimum.coverage>
        <skipITs>false</skipITs>
        <radiusward.interop>false</radiusward.interop>

        <!-- SonarQube Cloud (CI only, with SONAR_TOKEN): coverage comes from the aggregate report of -Pcoverage -->
        <sonar-plugin.version>5.8.0.7211</sonar-plugin.version>
        <sonar.organization>radiusward</sonar.organization>
        <sonar.projectKey>radiusward_radiusward-server</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/testing/coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/target/generated-sources/**</sonar.exclusions>
        <sonar.coverage.exclusions>testing/**,distribution/**</sonar.coverage.exclusions>
    </properties>

