    <modelVersion>4.0.0</modelVersion>

    <groupId>io.radiusward</groupId>
    <artifactId>radiusward-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>radiusward</name>
    <description>Replicated RADIUS accounting server built on Aeron Cluster</description>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>radius-dictionary</module>
        <module>radius-dictionary-freeradius</module>
        <module>radius-codegen</module>
        <module>radius-codec</module>
        <module>protocol</module>
        <module>common</module>
        <module>cluster-service</module>
        <module>export-api</module>
        <module>exporter</module>
        <module>sinks/file</module>
        <module>sinks/postgres</module>
        <module>sinks/radius</module>
        <module>cluster-node</module>
        <module>auth-api</module>
