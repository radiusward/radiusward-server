<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>distribution</artifactId>
    <name>radiusward :: distribution</name>
    <description>Single runnable radiusward.jar (cluster-node | gateway)</description>

    <dependencies>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>cluster-node</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>store-file</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>store-sql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>store-ldap</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>radclient</artifactId>
        </dependency>
        <dependency>
            <groupId>io.radiusward</groupId>
            <artifactId>admin-cli</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>radiusward</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.radiusward.distribution.Main</mainClass>
                                    <manifestEntries>
                                        <Add-Exports>java.base/jdk.internal.misc</Add-Exports>
                                        <Add-Opens>java.base/sun.nio.ch java.base/java.nio</Add-Opens>
                                        <Multi-Release>true</Multi-Release>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
