<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Copyright 2026 The radiusward Authors
  SPDX-License-Identifier: Apache-2.0

  Messages between gateways, the cluster and tools, plus the snapshot format.
  Rules (ADR 0005, docs/protocol.md): fields are only appended; every new field gets sinceVersion;
  the schema version increments with each change; ids are never reused.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="io.radiusward.protocol"
                   id="7101"
                   version="3"
                   semanticVersion="3.0"
                   description="radiusward cluster protocol"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding">
            <type name="length" primitiveType="uint32" maxValue="65535"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <composite name="varDataEncoding">
            <type name="length" primitiveType="uint32" maxValue="65535"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>

        <enum name="Outcome" encodingType="uint8" description="Result of applying an accounting event">
            <validValue name="APPLIED" description="new event, state changed">0</validValue>
            <validValue name="DUPLICATE" description="same event seen before; the NAS gets an ACK">1</validValue>
            <validValue name="STALE" description="older than the stored progress; ACK, not applied">2</validValue>
        </enum>
        <enum name="RejectReason" encodingType="uint8">
            <validValue name="CAPACITY">0</validValue>
            <validValue name="INVALID">1</validValue>
            <validValue name="EXPORT_LAG" sinceVersion="2" description="a required sink is more than maxLag behind">2</validValue>
        </enum>
        <enum name="OnMaxLag" encodingType="uint8" sinceVersion="2">
            <validValue name="BLOCK" description="stop acknowledging new accounting">0</validValue>
            <validValue name="DETACH" description="release the log, alert, resync by hand">1</validValue>
        </enum>
        <enum name="LeaseResult" encodingType="uint8" sinceVersion="2">
            <validValue name="GRANTED" description="the sender holds the lease (renewed or taken over)">0</validValue>
            <validValue name="NOT_OWNER" description="another member holds a valid lease">1</validValue>
            <validValue name="FULL" description="no room for another sink">2</validValue>
        </enum>
        <type name="SinkName" primitiveType="char" length="32" characterEncoding="US-ASCII" sinceVersion="2"/>
        <enum name="SessionStatus" encodingType="uint8">
            <validValue name="UNKNOWN">0</validValue>
            <validValue name="ACTIVE">1</validValue>
            <validValue name="STOPPED">2</validValue>
        </enum>
        <set name="EventFlags" encodingType="uint8" description="Which optional RADIUS values were present">
            <choice name="sessionTimePresent">0</choice>
            <choice name="eventTimestampPresent">1</choice>
            <choice name="sessionIdPresent">2</choice>
            <choice name="deviceUnknown" sinceVersion="3"
                    description="the NAS entry identifies devices by attribute, but the request carried none">3</choice>
        </set>
    </types>

    <!-- gateway -> cluster -->
    <sbe:message name="AccountingCommand" id="1" description="One accounting event to apply">
        <field name="correlationId" id="1" type="int64"/>
        <field name="gatewayId" id="2" type="int32"/>
        <field name="nasId" id="3" type="int32"/>
        <field name="sessionKeyHi" id="4" type="int64"/>
        <field name="sessionKeyLo" id="5" type="int64"/>
        <field name="exactKeyHi" id="6" type="int64"/>
        <field name="exactKeyLo" id="7" type="int64"/>
        <field name="statusType" id="8" type="uint32"/>
        <field name="flags" id="9" type="EventFlags"/>
        <field name="sessionTime" id="10" type="uint32"/>
        <field name="eventTimestamp" id="11" type="uint32"/>
        <field name="inputOctets" id="12" type="int64" description="64 bit, gigawords combined"/>
        <field name="outputOctets" id="13" type="int64" description="64 bit, gigawords combined"/>
        <field name="nasClientId" id="16" type="int32" sinceVersion="3"
               description="the configured NAS entry; nasId is its device scope (equal unless identity is set)"/>
        <field name="identityFingerprint" id="17" type="int32" sinceVersion="3"
               description="hash of the entry's identity setting; equal on every gateway"/>
        <data name="sessionId" id="14" type="varStringEncoding"/>
        <data name="rawAttributes" id="15" type="varDataEncoding" description="attribute section of the request, for export"/>
        <data name="nasDevice" id="18" type="varStringEncoding" sinceVersion="3"
              description="normalised device identity; empty for identity source-ip or when missing"/>
    </sbe:message>

    <!-- cluster -> gateway -->
    <sbe:message name="AccountingCommitted" id="2" description="The event is committed or was a duplicate; the gateway may answer">
        <field name="correlationId" id="1" type="int64"/>
        <field name="outcome" id="2" type="Outcome"/>
        <field name="eventId" id="3" type="int64" description="log position of the applied event"/>
    </sbe:message>
    <sbe:message name="AccountingRejected" id="3" description="Not applied; the gateway stays silent">
        <field name="correlationId" id="1" type="int64"/>
        <field name="reason" id="2" type="RejectReason"/>
    </sbe:message>

    <!-- exporter -> cluster -> exporter (Phase 3, ADR 0017) -->
    <sbe:message name="ExportCheckpoint" id="8" sinceVersion="2"
                 description="Claims or renews a sink's lease and records how far the sink has durably written">
        <field name="correlationId" id="1" type="int64"/>
        <field name="sinkName" id="2" type="SinkName"/>
        <field name="memberId" id="3" type="int32"/>
        <field name="epoch" id="4" type="int64" description="lease epoch the sender believes it holds; 0 to claim"/>
        <field name="position" id="5" type="int64" description="log position written durably by the sink"/>
        <field name="lastEventTime" id="6" type="int64" description="cluster time of the entry at position"/>
        <field name="leaseTimeoutMs" id="7" type="int64"/>
        <field name="required" id="8" type="uint8"/>
        <field name="maxLagBytes" id="9" type="int64" description="0 = no limit by size"/>
        <field name="maxLagMs" id="10" type="int64" description="0 = no limit by time"/>
        <field name="onMaxLag" id="11" type="OnMaxLag"/>
    </sbe:message>
    <sbe:message name="ExportCheckpointAck" id="9" sinceVersion="2">
        <field name="correlationId" id="1" type="int64"/>
        <field name="result" id="2" type="LeaseResult"/>
        <field name="owner" id="3" type="int32"/>
        <field name="epoch" id="4" type="int64"/>
        <field name="checkpoint" id="5" type="int64"/>
        <field name="detached" id="6" type="uint8"/>
        <field name="resync" id="7" type="uint8" description="1: start from checkpoint, ignore the sink's own position"/>
    </sbe:message>

    <!-- every member -> cluster: how far its own copy of the log reaches (log purge floor, ADR 0014) -->
    <sbe:message name="MemberLogPosition" id="10" sinceVersion="2">
        <field name="memberId" id="1" type="int32"/>
        <field name="logPosition" id="2" type="int64" description="this member's local log recording position"/>
    </sbe:message>

    <!-- admin -> cluster -> admin: sinks in the replicated state (radiusward admin sinks | resync) -->
    <sbe:message name="SinkQuery" id="11" sinceVersion="2">
        <field name="correlationId" id="1" type="int64"/>
    </sbe:message>
    <sbe:message name="SinkResync" id="13" sinceVersion="2"
                 description="Moves a sink's checkpoint (also back), fences its exporter and re-attaches it">
        <field name="correlationId" id="1" type="int64"/>
        <field name="sinkName" id="2" type="SinkName"/>
        <field name="position" id="3" type="int64"/>
    </sbe:message>
    <sbe:message name="SinkReport" id="12" sinceVersion="2">
        <field name="correlationId" id="1" type="int64"/>
        <field name="logPosition" id="2" type="int64" description="position of the last accounting entry"/>
        <group name="sinks" id="3" dimensionType="groupSizeEncoding">
            <field name="name" id="1" type="SinkName"/>
            <field name="checkpoint" id="2" type="int64"/>
            <field name="owner" id="3" type="int32"/>
            <field name="epoch" id="4" type="int64"/>
            <field name="leaseExpiry" id="5" type="int64"/>
            <field name="required" id="6" type="uint8"/>
            <field name="detached" id="7" type="uint8"/>
            <field name="resync" id="8" type="uint8"/>
        </group>
    </sbe:message>

    <!-- admin / tests -->
    <sbe:message name="SessionQuery" id="4">
        <field name="correlationId" id="1" type="int64"/>
        <field name="sessionKeyHi" id="2" type="int64"/>
        <field name="sessionKeyLo" id="3" type="int64"/>
    </sbe:message>
    <sbe:message name="SessionReport" id="5">
        <field name="correlationId" id="1" type="int64"/>
        <field name="status" id="2" type="SessionStatus"/>
        <field name="nasId" id="3" type="int32"/>
        <field name="statusType" id="4" type="uint32"/>
        <field name="sessionTime" id="5" type="uint32"/>
        <field name="eventTimestamp" id="6" type="uint32"/>
        <field name="inputOctets" id="7" type="int64"/>
        <field name="outputOctets" id="8" type="int64"/>
    </sbe:message>
    <sbe:message name="StateQuery" id="6">
        <field name="correlationId" id="1" type="int64"/>
    </sbe:message>
    <sbe:message name="StateReport" id="7">
        <field name="correlationId" id="1" type="int64"/>
        <field name="applied" id="2" type="int64"/>
        <field name="duplicates" id="3" type="int64"/>
        <field name="stale" id="4" type="int64"/>
        <field name="rejected" id="5" type="int64"/>
        <field name="activeSessions" id="6" type="int64"/>
        <field name="stoppedSessions" id="7" type="int64"/>
        <field name="stateDigest" id="8" type="int64"/>
        <field name="stateVersion" id="9" type="int32"/>
    </sbe:message>

    <!-- snapshot, written by onTakeSnapshot and read in onStart -->
    <sbe:message name="SnapshotHeader" id="20">
        <field name="stateVersion" id="1" type="int32"/>
        <field name="applied" id="2" type="int64"/>
        <field name="duplicates" id="3" type="int64"/>
        <field name="stale" id="4" type="int64"/>
        <field name="rejected" id="5" type="int64"/>
        <field name="stateDigest" id="6" type="int64"/>
        <field name="sessionCount" id="7" type="int64"/>
        <field name="exactKeyCount" id="8" type="int64"/>
        <field name="timerScheduled" id="9" type="uint8"/>
        <field name="sinkCount" id="10" type="int32" sinceVersion="2"/>
        <field name="lastCommandPosition" id="11" type="int64" sinceVersion="2"/>
        <field name="memberPositionCount" id="12" type="int32" sinceVersion="2"/>
    </sbe:message>
    <sbe:message name="SessionChunk" id="21">
        <group name="sessions" id="1" dimensionType="groupSizeEncoding">
            <field name="keyHi" id="1" type="int64"/>
            <field name="keyLo" id="2" type="int64"/>
            <field name="nasId" id="3" type="int32"/>
            <field name="status" id="4" type="SessionStatus"/>
            <field name="statusType" id="5" type="uint8"/>
            <field name="sessionTime" id="6" type="uint32"/>
            <field name="eventTimestamp" id="7" type="uint32"/>
            <field name="inputOctets" id="8" type="int64"/>
            <field name="outputOctets" id="9" type="int64"/>
            <field name="startKey" id="10" type="int32"/>
            <field name="lastSeen" id="11" type="int32"/>
            <field name="tombstoneUntil" id="12" type="int32"/>
            <field name="flags" id="13" type="uint8"/>
        </group>
    </sbe:message>
    <sbe:message name="ExactKeyChunk" id="22">
        <group name="keys" id="1" dimensionType="groupSizeEncoding">
            <field name="key" id="1" type="int64"/>
            <field name="expiry" id="2" type="int64"/>
        </group>
    </sbe:message>
    <sbe:message name="SinkChunk" id="24" sinceVersion="2">
        <group name="sinks" id="1" dimensionType="groupSizeEncoding">
            <field name="name" id="1" type="SinkName"/>
            <field name="checkpoint" id="2" type="int64"/>
            <field name="owner" id="3" type="int32"/>
            <field name="epoch" id="4" type="int64"/>
            <field name="leaseExpiry" id="5" type="int64"/>
            <field name="lastEventTime" id="6" type="int64"/>
            <field name="behindSince" id="7" type="int64"/>
            <field name="required" id="8" type="uint8"/>
            <field name="maxLagBytes" id="9" type="int64"/>
            <field name="maxLagMs" id="10" type="int64"/>
            <field name="onMaxLag" id="11" type="OnMaxLag"/>
            <field name="detached" id="12" type="uint8"/>
            <field name="resyncFrom" id="13" type="int64" description="-1 = no resync pending"/>
        </group>
    </sbe:message>
    <sbe:message name="MemberPositionChunk" id="25" sinceVersion="2">
        <group name="members" id="1" dimensionType="groupSizeEncoding">
            <field name="memberId" id="1" type="int32"/>
            <field name="logPosition" id="2" type="int64"/>
        </group>
    </sbe:message>
    <sbe:message name="SnapshotFooter" id="23">
        <field name="sessionCount" id="1" type="int64"/>
        <field name="exactKeyCount" id="2" type="int64"/>
    </sbe:message>
</sbe:messageSchema>
