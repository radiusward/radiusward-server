<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.radiusward</groupId>
        <artifactId>radiusward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>protocol</artifactId>
    <name>radiusward :: protocol</name>
    <description>SBE messages between gateways, cluster and tools</description>

    <dependencies>
        <dependency>
            <groupId>org.agrona</groupId>
            <artifactId>agrona</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- a JVM of its own: SbeTool reads its settings from system properties, which a parallel
                             build (-T1C) would share and reset under it, writing the codecs into the working dir -->
                        <id>generate-codecs</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>-Dsbe.output.dir=${project.build.directory}/generated-sources/sbe</argument>
                                <argument>-Dsbe.validation.stop.on.error=true</argument>
                                <argument>-Dsbe.validation.warnings.fatal=true</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>uk.co.real_logic.sbe.SbeTool</argument>
                                <argument>${project.basedir}/src/main/resources/sbe/radiusward-schema.xml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- a future schema version, used to prove forward compatibility of the v1 decoders -->
                        <id>generate-test-codecs</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>-Dsbe.output.dir=${project.build.directory}/generated-test-sources/sbe</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>uk.co.real_logic.sbe.SbeTool</argument>
                                <argument>${project.basedir}/src/test/resources/sbe/radiusward-schema-v2-test.xml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>uk.co.real-logic</groupId>
                        <artifactId>sbe-tool</artifactId>
                        <version>${sbe.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/sbe</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-generated-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-test-sources/sbe</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- generated codecs only; the round-trip tests exercise them -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
