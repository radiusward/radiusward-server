<?xml version="1.0" encoding="UTF-8"?>
<!--
  CI only (.github/actions/setup-maven): Google's mirror of Maven Central is asked first, Central itself for anything
  the mirror does not have yet (a release of the last hours). Both serve the same, checksummed artifacts.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>central-mirror</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-mirror</activeProfile>
  </activeProfiles>
</settings>
